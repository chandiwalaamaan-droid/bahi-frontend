# Backend API base URL. Leave blank for local dev (Vite proxies /api to
# http://localhost:3001 — see vite.config.js). Set to your deployed backend's
# URL in production, e.g. https://bahi-backend.onrender.com
VITE_API_URL=

# Optional: enables the "Sign in with Google" button. Get one from
# https://console.cloud.google.com/apis/credentials — leave blank to hide it.
VITE_GOOGLE_CLIENT_ID=

# Optional: shown in the FAQ & Support panel as a contact address.
# Leave blank and that line is simply omitted — nothing else depends on it.
VITE_SUPPORT_EMAIL=
